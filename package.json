{
  "name": "omnigrab",
  "version": "1.0.0",
  "description": "OmniGrab - Universal YouTube & SoundCloud Downloader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "dist:dir": "electron-builder --win --dir",
    "dist:portable": "electron-builder --win portable"
  },
  "keywords": [
    "electron",
    "youtube",
    "soundcloud",
    "downloader"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.omnigrab.app",
    "productName": "OmniGrab",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "downloader.py",
        "to": "downloader.py"
      }
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
